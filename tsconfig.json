{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "types": ["bun", "node", "vitest/globals"],
    "customConditions": ["bun"]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
