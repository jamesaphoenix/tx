{
  "name": "@jamesaphoenix/tx-cli",
  "version": "0.16.0",
  "description": "TX command line tool - task management for AI agents and humans",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "tx": "./dist/cli.js",
    "tx-mcp": "./dist/mcp/server.js",
    "tx-api": "./dist/api/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./mcp/runtime": {
      "types": "./dist/mcp/runtime.d.ts",
      "import": "./dist/mcp/runtime.js"
    },
    "./mcp/response": {
      "types": "./dist/mcp/response.d.ts",
      "import": "./dist/mcp/response.js"
    },
    "./mcp/tools/task": {
      "types": "./dist/mcp/tools/task.d.ts",
      "import": "./dist/mcp/tools/task.js"
    },
    "./mcp/tools/learning": {
      "types": "./dist/mcp/tools/learning.d.ts",
      "import": "./dist/mcp/tools/learning.js"
    },
    "./mcp/tools/sync": {
      "types": "./dist/mcp/tools/sync.d.ts",
      "import": "./dist/mcp/tools/sync.js"
    },
    "./mcp/tools/spec-trace": {
      "types": "./dist/mcp/tools/spec-trace.d.ts",
      "import": "./dist/mcp/tools/spec-trace.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/runtime": {
      "types": "./dist/api/runtime.d.ts",
      "import": "./dist/api/runtime.js"
    },
    "./api/routes/tasks": {
      "types": "./dist/api/routes/tasks.d.ts",
      "import": "./dist/api/routes/tasks.js"
    },
    "./api/routes/runs": {
      "types": "./dist/api/routes/runs.d.ts",
      "import": "./dist/api/routes/runs.js"
    },
    "./api/routes/learnings": {
      "types": "./dist/api/routes/learnings.d.ts",
      "import": "./dist/api/routes/learnings.js"
    },
    "./api/routes/sync": {
      "types": "./dist/api/routes/sync.d.ts",
      "import": "./dist/api/routes/sync.js"
    },
    "./api/routes/spec-trace": {
      "types": "./dist/api/routes/spec-trace.d.ts",
      "import": "./dist/api/routes/spec-trace.js"
    },
    "./api/routes/health": {
      "types": "./dist/api/routes/health.d.ts",
      "import": "./dist/api/routes/health.js"
    }
  },
  "files": [
    "dist",
    "!dist/tx",
    "!dist/tx-*",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b && cp -r src/templates dist/templates",
    "build:binary": "bun build ./src/cli.ts --compile --outfile dist/tx --minify --external @anthropic-ai/sdk --external @anthropic-ai/claude-agent-sdk --external openai --external node-llama-cpp --external @node-llama-cpp/*",
    "build:darwin-arm64": "bun build ./src/cli.ts --compile --outfile dist/tx-darwin-arm64 --target bun-darwin-arm64 --minify --external @anthropic-ai/sdk --external @anthropic-ai/claude-agent-sdk --external openai --external node-llama-cpp --external @node-llama-cpp/*",
    "build:darwin-x64": "bun build ./src/cli.ts --compile --outfile dist/tx-darwin-x64 --target bun-darwin-x64 --minify --external @anthropic-ai/sdk --external @anthropic-ai/claude-agent-sdk --external openai --external node-llama-cpp --external @node-llama-cpp/*",
    "build:linux-x64": "bun build ./src/cli.ts --compile --outfile dist/tx-linux-x64 --target bun-linux-x64 --minify --external @anthropic-ai/sdk --external @anthropic-ai/claude-agent-sdk --external openai --external node-llama-cpp --external @node-llama-cpp/*",
    "build:linux-arm64": "bun build ./src/cli.ts --compile --outfile dist/tx-linux-arm64 --target bun-linux-arm64 --minify --external @anthropic-ai/sdk --external @anthropic-ai/claude-agent-sdk --external openai --external node-llama-cpp --external @node-llama-cpp/*",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bunx --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.107.0",
    "@jamesaphoenix/tx": "*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "effect": "^3.19.15",
    "yaml": "^2.5.0",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesaphoenix/tx.git",
    "directory": "apps/cli"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "tx",
    "cli",
    "task-management",
    "effect-ts"
  ],
  "author": "James Phoenix",
  "license": "MIT"
}
