{
  "name": "@jamesaphoenix/tx-agent-sdk",
  "version": "0.20.0",
  "description": "Tasks, specifications, plans and verification evidence for coding agents and humans",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bunx --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jamesaphoenix/tx": "*"
  },
  "optionalDependencies": {
    "effect": "^3.19.15"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.1.2",
    "effect": "^3.19.15",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "tasks",
    "spec-driven-development",
    "plans",
    "invariants",
    "cli",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesaphoenix/tx.git",
    "directory": "apps/agent-sdk"
  },
  "homepage": "https://txdocs.dev/",
  "author": "James Phoenix",
  "license": "MIT"
}
