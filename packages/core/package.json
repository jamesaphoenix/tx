{
  "name": "@jamesaphoenix/tx",
  "version": "0.20.1",
  "description": "Tasks, specifications, plans and verification evidence for coding agents and humans",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./services": {
      "bun": "./src/services/index.ts",
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./repo": {
      "bun": "./src/repo/index.ts",
      "types": "./dist/repo/index.d.ts",
      "import": "./dist/repo/index.js"
    },
    "./schemas": {
      "bun": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./mappers": {
      "bun": "./src/mappers/index.ts",
      "types": "./dist/mappers/index.d.ts",
      "import": "./dist/mappers/index.js"
    },
    "./layer": {
      "bun": "./src/layer.ts",
      "types": "./dist/layer.d.ts",
      "import": "./dist/layer.js"
    },
    "./types": {
      "bun": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/bundle-migrations.js",
    "build": "rm -rf dist && tsc -b --force && { rm -rf ./migrations && mkdir -p ./migrations && cp -R ../../migrations/. ./migrations/; }",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bunx --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "effect": "^3.22.2",
    "fast-xml-parser": "^5.2.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesaphoenix/tx.git",
    "directory": "packages/core"
  },
  "author": "James Phoenix",
  "license": "MIT",
  "keywords": [
    "tasks",
    "spec-driven-development",
    "plans",
    "invariants",
    "cli",
    "mcp"
  ]
}
