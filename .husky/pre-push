#!/bin/sh

# Pre-push hook: Block push unless build + tests pass
# Uses the existing check.sh script for comprehensive validation

# Git exports repository-local variables to hooks. If the test suite creates a
# temporary repository, those variables can redirect its git commands back to
# this checkout. Clear them before starting any subprocesses. Git commands run
# by this hook rediscover the repository from the working directory.
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS \
    GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_DIR GIT_WORK_TREE \
    GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_INDEX_FILE \
    GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_PREFIX \
    GIT_SHALLOW_FILE GIT_COMMON_DIR

echo "🔍 Running pre-push checks..."
echo ""

# Run all checks (types, lint, build, tests)
./scripts/check.sh --all

exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo ""
    echo "❌ Push blocked: checks failed"
    echo "Fix the issues above and try again."
    exit 1
fi

echo ""
echo "✅ All checks passed. Pushing..."
